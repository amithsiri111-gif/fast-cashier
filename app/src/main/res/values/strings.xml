    <!-- User Guide -->
    <string name="guide_section1_title">1. Cash Deposit Walkthrough</string>
    <string name="guide_section1_step1">Tap Deposit on the bottom menu bar.</string>
    <string name="guide_section1_step2">Choose your preferred bank account (BOC, People\'s Bank, Sampath Bank, LOLC Finance, iPay).</string>
    <string name="guide_section1_step3">Transfer funds to the shown account number. Make sure to put your 1xBet Player ID in the transfer remark.</string>
    <string name="guide_section1_step4">Upload a clear receipt photo or screenshot (JPG/PNG).</string>
    <string name="guide_section1_step5">The AI scanner verifies the receipt details. Confirm your 1xBet Player ID and submit.</string>
    <string name="guide_section1_step6">Funds will be credited to your 1xBet account within 5–15 minutes!</string>

    <string name="guide_section2_title">2. Cash Withdrawal Walkthrough</string>
    <string name="guide_section2_step1">Open 1xBet app -&gt; Withdraw -&gt; Select 1xBet Cash.</string>
    <string name="guide_section2_step2">Choose Address: Walasmulla, Beliaththa Road 24/7.</string>
    <string name="guide_section2_step3">Enter amount (LKR 1,000 - 500,000) and obtain your 4-digit Secret Code.</string>
    <string name="guide_section2_step4">Open Fast Xbet Cashier app -&gt; Tap Withdraw on bottom menu.</string>
    <string name="guide_section2_step5">Fill in your Player ID, Secret Code, Amount, and Bank account details.</string>
    <string name="guide_section2_step6">Tap Submit. Once approved, funds will be transferred to your bank within 5–15 minutes!</string>

    <string name="guide_section3_title">3. 1xBet Registration &amp; 150% Bonus</string>
    <string name="guide_section3_step1">Tap \'Register on 1xBet\' on the home screen.</string>
    <string name="guide_section3_step2">Complete registration details.</string>
    <string name="guide_section3_step3">Use Promo Code: VGSL</string>
    <string name="guide_section3_step4">Receive 150% Bonus on your first deposit!</string>

    <string name="guide_section4_title">4. Daily Free Tips</string>
    <string name="guide_section4_step1">Tap \'Join Free Tips Telegram\' on the home screen.</string>
    <string name="guide_section4_step2">Join our official Telegram community channel.</string>
    <string name="guide_section4_step3">Get daily free betting tips and predictions!</string>

    <!-- Privacy Policy -->
    <string name="privacy_title">Privacy Policy</string>
    <string name="privacy_body">🔒 PRIVACY POLICY — Fast Xbet Official Sri Lanka\n\n1. Information We Collect:\n• Your 1xBet User ID\n• Deposit receipts to confirm transactions\n• Security codes for withdrawals\n• Your bank account details (for fund transfers only)\n\n2. How We Use Information:\n• Credit funds to your 1xBet account\n• Process and transfer approved withdrawals to your bank account\n\n3. Data Protection:\n• We never sell or share your personal information with third parties\n• Transaction data is kept strictly confidential\n\n4. Disclaimer:\n• Our service is limited to facilitating deposits and withdrawals\n• We are not responsible for technical issues with 1xBet or losses from gameplay\n• Keeping your 1xBet account credentials secure is your responsibility\n\n5. Contact Us:\n📞 +94765865387\n© 2026 Fast Xbet Official Sri Lanka. All rights reserved.</string>

    <!-- FAQ Accordion -->
    <string name="faq_title">Frequently Asked Questions (FAQ)</string>
    <string name="faq_subtitle">Quick answers to common deposit and withdrawal questions</string>
    <string name="faq_q1">How long does a deposit take?</string>
    <string name="faq_a1">Deposits are reviewed and credited directly to your 1xBet account within 5–15 minutes after receipt submission.</string>
    <string name="faq_q2">How long does a withdrawal take?</string>
    <string name="faq_a2">Withdrawals are verified against your 1xBet Secret Code and transferred to your bank account within 5–15 minutes.</string>
    <string name="faq_q3">What are the withdrawal limits?</string>
    <string name="faq_a3">The minimum withdrawal amount is LKR 1,000 and the maximum is LKR 500,000 per request.</string>
    <string name="faq_q4">What should I put in the bank transfer remark?</string>
    <string name="faq_a4">Always type your 1xBet Player ID in the bank transfer remark or reference so our team can immediately identify and credit your deposit.</string>
    <string name="faq_q5">Where do I get the 4-digit Secret Code for withdrawal?</string>
    <string name="faq_a5">In the 1xBet app, request a withdrawal via \'1xBet Cash\' choosing Address: Walasmulla, Beliaththa Road 24/7. Once approved by 1xBet, a 4-digit secret code will be displayed in your 1xBet account.</string>
    <string name="faq_q6">Are my bank details and personal data safe?</string>
    <string name="faq_a6">Yes! All transaction details are strictly encrypted and used solely for fund transfers. We never ask for your 1xBet password or PIN.</string>
