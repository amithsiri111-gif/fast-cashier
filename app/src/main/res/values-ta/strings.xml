    <!-- FAQ Accordion -->
    <string name="faq_title">அடிக்கடி கேட்கப்படும் கேள்விகள் (FAQ)</string>
    <string name="faq_subtitle">வைப்பு மற்றும் திரும்பப் பெறல்கள் பற்றிய கேள்விகளுக்கான விரைவான பதில்கள்</string>
